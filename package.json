{
  "scripts": {
    "build": "esbuild src/app.ts --bundle --minify --outfile=static/app.js --format=iife && esbuild src/codemirror.ts --bundle --minify --outfile=static/codemirror.js --format=esm",
    "typecheck": "tsc --noEmit",
    "format:web": "find src templates -type f \\( -name '*.ts' -o -name '*.tsx' -o -name '*.html' \\) -exec prettier --write {} \\;",
    "format:python": "uv run --group dev ruff format .",
    "format:go": "gofmt -w cmd/4orm/*.go",
    "format": "npm run format:web && npm run format:python && npm run format:go",
    "precheck": "npm run format && npm run typecheck && npm run build && uv run --group dev ruff check . && uv run --group dev pytest tests/ -v && go test ./..."
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@lezer/highlight": "^1.2.3",
    "codemirror": "^6.0.2",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.6",
    "prettier-plugin-jinja-template": "^2.2.0",
    "typescript": "^7.0.2"
  }
}
